{
  "name": "@operador/harness",
  "version": "0.1.0",
  "private": true,
  "description": "Local evaluation harness: reset → task → __check → contract checks",
  "scripts": {
    "task": "tsx --env-file=../../.env src/run-task.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@operador/operator": "workspace:*",
    "@operador/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
