{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "operador",
  "account_id": "e0f12f68b53de6eeb701bd6787e00f90",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "OperatorContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OPERATOR", "class_name": "OperatorContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OperatorContainer"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "operador", "database_id": "d74c46b3-d051-4629-80ce-0226532a1640", "migrations_dir": "migrations" }
  ],
  "vars": {
    "OPENROUTER_MODEL": "anthropic/claude-sonnet-5.5",
    "TEAM_NAME": "operador",
    "KEEP_ALIVE": "1",
    "PUBLIC_URL": "https://operador.jose-de-jesus-acevedo-flores.workers.dev"
  }
  // Secrets (set with `wrangler secret put`): TEAM_TOKEN, OPENROUTER_API_KEY
}
