{
  "name": "operador-monorepo",
  "private": true,
  "packageManager": "pnpm@10.12.3",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --filter=api",
